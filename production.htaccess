Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # The PHP API must be resolved before the React SPA fallback.
  RewriteRule ^api/?$ api/index.php [L,QSA]
  RewriteRule ^api/(.*)$ api/index.php [L,QSA]

  # Serve real build assets and public files normally.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # All remaining URLs are client-side React routes.
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=()"
</IfModule>

<FilesMatch "(^\.|\.(?:env|ini|log|sql|bak|pem|key)$)">
  Require all denied
</FilesMatch>
