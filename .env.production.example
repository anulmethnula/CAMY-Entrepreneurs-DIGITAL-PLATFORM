# Copy these values to /home/camymarket/private/camy.env on the server.
# Never upload the populated camy.env file to public_html.
CAMY_ENV=production
CAMY_PRIVATE_PATH=/home/camymarket/private
CAMY_SCHEMA_PATH=/home/camymarket/private/schema.sql
CAMY_DATA_PATH=/home/camymarket/private/catalogue
DB_HOST=localhost
DB_PORT=3306
DB_NAME=camymarket_database_name
DB_USER=camymarket_database_user
DB_PASS=replace_with_a_long_random_database_password
CAMY_BOOTSTRAP_PASSWORD=replace_with_a_unique_temporary_admin_password
