# Copy these values to /home/CPANEL_USERNAME/private/camy.env on the server.
# Never upload the populated camy.env file to public_html.
CAMY_ENV=production
CAMY_PRIVATE_PATH=/home/CPANEL_USERNAME/private
CAMY_SCHEMA_PATH=/home/CPANEL_USERNAME/private/schema.sql
CAMY_DATA_PATH=/home/CPANEL_USERNAME/private/catalogue
DB_HOST=localhost
DB_PORT=3306
DB_NAME=camymarket_database_name
DB_USER=camymarket_database_user
DB_PASS=replace_with_a_long_random_database_password
CAMY_BOOTSTRAP_PASSWORD=replace_with_a_unique_temporary_admin_password
CAMY_PUBLIC_URL=https://camymarket.com
CAMY_MAIL_FROM=notifications@camymarket.com
CAMY_MAIL_FROM_NAME=CAMY Entrepreneurs

# Direct Sales (optional settings; no tax information is fabricated).
CAMY_DIRECT_RECEIPT_MAX_MB=20
# Leave blank to disable the additional percentage approval threshold (0-100).
CAMY_DIRECT_MAX_DISCOUNT_PERCENT=
# Populate these with actual configured company details before issuing invoices.
CAMY_COMPANY_NAME=
CAMY_COMPANY_ADDRESS=
CAMY_COMPANY_PHONE=
CAMY_COMPANY_EMAIL=
CAMY_COMPANY_TAX_NUMBER=
